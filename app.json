{
  "expo": {
    "name": "Indigo Habits",
    "slug": "indigo-habits",
    "scheme": "indigohabits",
    "version": "1.0.58",
    "orientation": "portrait",
    "icon": "./assets/images/indigo-blue-flame-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/indigo-blue-flame-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B5C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.indigohabits.journal2026",
      "buildNumber": "60",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Indigo Habits needs access to your photos to add images to your journal entries.",
        "NSMicrophoneUsageDescription": "Indigo Habits uses your microphone to turn your spoken journal thoughts into text."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/indigo-blue-flame-icon.png",
        "backgroundColor": "#0B0B5C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.indigohabits.journal2026",
      "versionCode": 1,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/indigo-blue-flame-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Indigo Habits needs access to your photos to add images to your journal entries.",
          "cameraPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#149BFF",
          "defaultChannel": "habits-reminders",
          "sounds": []
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Indigo Habits uses your microphone to turn your spoken journal thoughts into text.",
          "speechRecognitionPermission": "Indigo Habits uses speech recognition to turn your spoken journal thoughts into text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c9f381e8-423f-4420-b5c5-d3e6b08dd99d"
      },
      "revenueCatApple": "appl_KVaWqlpxQpKqoMgILPRLHowDNxe",
      "revenueCatGoogle": "goog_eNogZNZZAtzunNmzzDNXxYafmpy",
      "backendUrl": "https://wtj7b5zqhh4h7kvtqmkdaefv9jzgd8n5.app.specular.dev"
    },
    "description": "Indigo Habits is a beautiful habit tracker and journal app that helps you build positive habits and reflect on your daily progress with affirmations, streaks, and mindful journaling.",
    "primaryColor": "#2637D9"
  }
}
