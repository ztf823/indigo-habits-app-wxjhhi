{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local",
    "requireCommit": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Debug"
      },
      "channel": "development",
      "env": {
        "COREPACK_ENABLE_STRICT": "0"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "COREPACK_ENABLE_STRICT": "0"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "node": "22.23.1",
      "pnpm": "11.19.0",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "COREPACK_ENABLE_STRICT": "0"
      }
    }
  }
}
